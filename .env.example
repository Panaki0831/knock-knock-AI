# ===========================================
# knock knock AI - Environment Configuration
# ===========================================

# --- LLM API Keys ---
ANTHROPIC_API_KEY=sk-ant-xxxxx
OPENAI_API_KEY=sk-xxxxx

# --- Database ---
DATABASE_URL=postgresql+asyncpg://knockknock:knockknock@localhost:5432/knockknock_ai
REDIS_URL=redis://localhost:6379/0

# --- Vector Database ---
PINECONE_API_KEY=xxxxx
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=knockknock-knowledge

# --- Web Search ---
TAVILY_API_KEY=tvly-xxxxx

# --- Content Platforms ---
NOTE_API_TOKEN=xxxxx
MEDIUM_API_TOKEN=xxxxx
WORDPRESS_URL=https://example.com
WORDPRESS_USERNAME=xxxxx
WORDPRESS_PASSWORD=xxxxx

# --- SNS ---
TWITTER_API_KEY=xxxxx
TWITTER_API_SECRET=xxxxx
TWITTER_ACCESS_TOKEN=xxxxx
TWITTER_ACCESS_TOKEN_SECRET=xxxxx
LINKEDIN_ACCESS_TOKEN=xxxxx

# --- SEO & Analytics ---
GOOGLE_SEARCH_CONSOLE_CREDENTIALS=xxxxx
AHREFS_API_KEY=xxxxx
GA4_PROPERTY_ID=xxxxx

# --- Application ---
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-this-to-a-random-secret
CORS_ORIGINS=http://localhost:3000

# --- Agent Configuration ---
# Use valid Anthropic model IDs. See https://docs.anthropic.com/en/docs/models
# Available: claude-sonnet-4-5-20250929, claude-haiku-4-5-20251001, claude-opus-4-6
# IMPORTANT: Do NOT use OpenAI model names (gpt-4o-mini, etc.) here -- this
# system uses the Anthropic API exclusively.
# Haiku is used for speed-critical agents; Sonnet for quality-critical writer/editor.
DEFAULT_ORCHESTRATOR_MODEL=claude-haiku-4-5-20251001
DEFAULT_WRITER_MODEL=claude-sonnet-4-5-20250929
DEFAULT_RESEARCHER_MODEL=claude-haiku-4-5-20251001
DEFAULT_PLANNER_MODEL=claude-haiku-4-5-20251001
DEFAULT_EDITOR_MODEL=claude-sonnet-4-5-20250929
DEFAULT_LOCALIZER_MODEL=claude-sonnet-4-5-20250929
DEFAULT_PUBLISHER_MODEL=claude-haiku-4-5-20251001
